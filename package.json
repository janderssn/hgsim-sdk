{
  "name": "hgsim",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "A hang-glider simulation SDK: flight, launch, landing and crash physics with no dependencies, and the landing range used to tune it.",
  "keywords": [
    "hang-gliding",
    "flight-simulation",
    "physics",
    "game",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./three": {
      "types": "./types/three.d.ts",
      "default": "./src/three/index.js"
    },
    "./ground": {
      "types": "./types/ground.d.ts",
      "default": "./src/ground/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:range": "node tools/range-check.mjs",
    "benchmark:range": "node tools/range-benchmark.mjs",
    "check:live": "node tools/range-check.mjs --url https://hgsim.fly.dev",
    "flights": "node tools/flight-report.mjs",
    "golden:record": "node tests/golden/record.mjs",
    "polars": "node tools/polars.mjs",
    "scenarios": "node tools/scenarios.mjs",
    "check:types": "npx -y -p typescript@5.6.3 tsc -p types",
    "types:configs": "node tools/config-types.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
