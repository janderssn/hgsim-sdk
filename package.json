{
  "name": "hgsim",
  "version": "0.1.0",
  "private": true,
  "description": "Hang-glider flight, launch and landing simulation from Above, with the landing range used to tune it.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./*.js": "./src/*.js",
    "./*": "./src/*.js"
  },
  "files": [
    "src",
    "range",
    "server.mjs",
    "tools"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:range": "node tools/range-check.mjs",
    "benchmark:range": "node tools/range-benchmark.mjs",
    "check:live": "node tools/range-check.mjs --url https://hgsim.fly.dev",
    "flights": "node tools/flight-report.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
